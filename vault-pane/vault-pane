#!/usr/bin/env bash
# vault-pane — öppna ett Deep Thought-transkript i en cmux-pane och kör /transcript.
#
#   vault-pane lunch                  senaste träffen på "lunch" i cachen
#   vault-pane lunch anna+erik        med deltagare till skillen
#   vault-pane --list                 vad ligger i cachen
#   vault-pane 260916_114054          matchar även filnamn/titel/DOC-id
#   vault-pane lunch -n               torrkörning: visa träff + prompt, öppna inget
#   vault-pane lunch --safe           kräv behörighetsfrågor (annars skippas de)
#
# Panen står kvar efteråt (claude startas interaktivt, inte headless).
# PWD sätts till valvroten så skillens rules-walk hittar _insights.yaml-kedjan.
set -euo pipefail

# Valvroten. Sätt VAULT_ROOT i din miljö (t.ex. i ~/.zshrc) — defaulten här är
# bara en gissning på var en iCloud-synkad Obsidian-vault brukar ligga.
VAULT="${VAULT_ROOT:-$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Vault}"
# Valvroten kontrolleras först när den faktiskt behövs (--list och --help läser
# bara cachen). Kravet låg tidigare överst och gjorde --list oanvändbart för den
# som inte satt VAULT_ROOT — ett fel om något som kommandot inte rör.
krav_vault() {
  [[ -d $VAULT ]] && return 0
  echo "vault-pane: hittar ingen valvrot på '$VAULT'." >&2
  echo "         Sätt VAULT_ROOT till din vault, t.ex.:" >&2
  echo "         export VAULT_ROOT=\"\$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/MittValv\"" >&2
  exit 2
}
CACHE="${VAULT_PANE_CACHE:-$HOME/.cache/vault-pane}"
mkdir -p "$CACHE"

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# Producenter som får fylla cachen (se CACHE-CONTRACT.md). Cachen är
# källagnostisk — vilken transkript-MCP som helst kan skriva hit så länge
# frontmattern följer kontraktet. Listan finns för att en TRASIG producent
# ska synas i stället för att tyst leverera dåliga filer.
KANDA_KALLOR="deep-thought klang"

kalla_for() { sed -n '1,/^---$/p' "$1" | sed -n 's/^källa:[[:space:]]*//p' | head -1; }
# Normalisera innan jämförelse: "Deep Thought", "deep thought" och
# "deep-thought" är samma producent. Annars blir kontraktet en stavningsfälla.
norm_kalla() { echo "$1" | tr '[:upper:] ' '[:lower:]-'; }

lista() {
  shopt -s nullglob
  local f=("$CACHE"/*.md)
  [[ ${#f[@]} -eq 0 ]] && { echo "Cachen är tom. Be Claude-sessionen hämta ett transkript."; return; }
  printf '%-14s %-7s %-14s %s\n' DATUM STORLEK KÄLLA TITEL
  for x in $(ls -t "$CACHE"/*.md); do
    local k; k="$(kalla_for "$x")"
    [[ -z $k ]] && k="(saknas!)"
    [[ $k != "(saknas!)" && " $KANDA_KALLOR " != *" $(norm_kalla "$k") "* ]] && k="$k?"
    printf '%-14s %-7s %-14s %s\n' \
      "$(date -r "$x" '+%y%m%d %H:%M')" \
      "$(du -h "$x" | cut -f1)" \
      "$k" \
      "$(basename "$x" .md)"
  done
}

[[ $# -eq 0 || ${1:-} == -h || ${1:-} == --help ]] && usage
[[ ${1:-} == --list || ${1:-} == -l ]] && { lista; exit 0; }

MONSTER=""; DELTAGARE=""; EXTRA=(); HEADLESS=0; TORR=0; RIKTNING="right"
# Panen körs utan behörighetsfrågor. Medvetet val: /transcript skriver många
# filer (summering, _insights.yaml, CHANGELOG, .transcripts/) och en fråga per
# skrivning gör panen obrukbar. Sätt VAULT_PANE_SAFE=1 eller --safe för att kräva frågor.
SKIP="${VAULT_PANE_SAFE:+0}"; SKIP="${SKIP:-1}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift; EXTRA+=("$@"); break ;;
    -p|--print) HEADLESS=1; shift ;;
    -n|--dry-run) TORR=1; shift ;;
    --safe) SKIP=0; shift ;;
    --direction) RIKTNING="$2"; shift 2 ;;
    *) if   [[ -z $MONSTER   ]]; then MONSTER="$1"
       elif [[ -z $DELTAGARE ]]; then DELTAGARE="$1"
       else EXTRA+=("$1"); fi; shift ;;
  esac
done

# En sökväg funkar fortfarande; annars sök i cachen, senaste först.
if [[ -f $MONSTER ]]; then
  KALLA="$(cd "$(dirname "$MONSTER")" && pwd)/$(basename "$MONSTER")"
else
  # Matcha på filnamn FÖRST, sedan på frontmattern (DOC-id, originalfilnamn,
  # titel, talare) — så både "lunch", "260916_114054" och DOC-id:t funkar.
  shopt -s nullglob nocaseglob
  KALLA=""
  for x in $(ls -t "$CACHE"/*.md 2>/dev/null); do
    if [[ "$(basename "$x")" == *"$MONSTER"* ]]; then KALLA="$x"; break; fi
  done
  if [[ -z $KALLA ]]; then
    for x in $(ls -t "$CACHE"/*.md 2>/dev/null); do
      if sed -n '1,/^---$/p' "$x" | sed -n '2,$p' | grep -qi -- "$MONSTER"; then
        KALLA="$x"; break
      fi
    done
  fi
  if [[ -z $KALLA ]]; then
    echo "vault-pane: ingen träff på '$MONSTER' i cachen." >&2
    echo >&2; lista >&2
    echo >&2
    echo "Nytt transkript hämtas av Claude-sessionen (MCP:n nås inte från skalet):" >&2
    echo "  \"hämta <namn> till dt-cachen\"" >&2
    exit 2
  fi
fi

# Kontraktet: källa: är enda fältet som valideras. Varning, inte stopp —
# filen kan vara fullt användbar ändå, men en trasig producent ska synas.
KALLTAG="$(kalla_for "$KALLA")"
if [[ -z $KALLTAG ]]; then
  echo "vault-pane: varning — '$(basename "$KALLA")' saknar 'källa:' i frontmattern." >&2
  echo "         Se CACHE-CONTRACT.md. Kör ändå." >&2
elif [[ " $KANDA_KALLOR " != *" $(norm_kalla "$KALLTAG") "* ]]; then
  echo "vault-pane: varning — okänd källa '$KALLTAG'." >&2
  echo "         Lägg till den i KANDA_KALLOR + CACHE-CONTRACT.md. Kör ändå." >&2
fi

PROMPT="/transcript ${DELTAGARE:+$DELTAGARE }'$KALLA'"

krav_vault
CLAUDE_ARGV=()
[[ $SKIP -eq 1 ]] && CLAUDE_ARGV+=(--dangerously-skip-permissions)
CLAUDE_ARGV+=(${EXTRA[@]+"${EXTRA[@]}"})

if [[ $TORR -eq 1 ]]; then
  echo "träff : $(basename "$KALLA")"
  echo "källa : ${KALLTAG:-(saknas)}"
  echo "pwd   : $VAULT"
  echo "claude: claude ${CLAUDE_ARGV[*]-}"
  echo "prompt: $PROMPT"
  exit 0
fi

if [[ $HEADLESS -eq 1 ]]; then
  cd "$VAULT"; exec claude -p "$PROMPT" ${CLAUDE_ARGV[@]+"${CLAUDE_ARGV[@]}"}
fi

command -v cmux >/dev/null || { echo "vault-pane: cmux saknas i PATH." >&2; exit 3; }

cmux new-pane --type terminal --direction "$RIKTNING" --focus true >/dev/null
PANE="$(cmux list-panes 2>/dev/null | grep -o 'pane:[0-9]*' | tail -1)"
[[ -z $PANE ]] && { echo "vault-pane: fick ingen pane-ref från cmux." >&2; exit 3; }

# cmux send tar --surface, INTE --pane. Med --pane blev flaggan tolkad som
# text och ekades ut i terminalen i stället för att köras. Slå upp panens
# surface och skicka dit.
YTA="$(cmux list-pane-surfaces --pane "$PANE" 2>/dev/null | grep -o 'surface:[0-9]*' | head -1)"
[[ -z $YTA ]] && { echo "vault-pane: hittade ingen surface för $PANE." >&2; exit 3; }

cmux send --surface "$YTA" "cd $(printf %q "$VAULT") && claude ${CLAUDE_ARGV[*]-}"'\n' >/dev/null 2>&1
sleep 4
cmux send --surface "$YTA" "$PROMPT"'\n' >/dev/null 2>&1

echo "vault-pane: $PANE/$YTA · ${DELTAGARE:-inga deltagare} · $(basename "$KALLA" .md)"
